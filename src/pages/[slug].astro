---
import "../styles/site.css";
import content from "../../content/home.json";
import HeroTop from "../components/HeroTop.astro";
import ContactFooter from "../components/ContactFooter.astro";
import { toTelHref } from "../lib/phone.js";

export const getStaticPaths = () =>
  content.servicePages.map((servicePage) => ({
    params: { slug: servicePage.slug },
    props: { servicePage },
  }));

const { servicePage } = Astro.props;
const { company, contact } = content;

const pageUrl = `https://barrysmithelectrical.ie/${servicePage.slug}/`;
const mobileHref = toTelHref(contact.mobile);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: servicePage.introHeading,
      url: pageUrl,
      description: servicePage.metaDescription,
      areaServed: [
        { "@type": "AdministrativeArea", name: "Dublin" },
        { "@type": "AdministrativeArea", name: "Leinster" },
      ],
      provider: {
        "@type": "Electrician",
        name: company.name,
        url: "https://barrysmithelectrical.ie/",
        telephone: mobileHref.replace("tel:", ""),
        sameAs: [contact.linkedin, contact.googleProfile].filter(Boolean),
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://barrysmithelectrical.ie/" },
        { "@type": "ListItem", position: 2, name: servicePage.homeLinkText, item: pageUrl },
      ],
    },
  ],
};
---

<html lang="en-IE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/fraulein.woff" as="font" type="font/woff" crossorigin />
    <link rel="canonical" href={pageUrl} />
    <title>{servicePage.metaTitle}</title>
    <meta name="description" content={servicePage.metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={servicePage.metaTitle} />
    <meta property="og:description" content={servicePage.metaDescription} />
    <meta property="og:image" content="https://barrysmithelectrical.ie/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Barry Smith Electrical Contractors Ltd — domestic, commercial, solar PV and EV chargers, Dublin and Leinster" />
    <meta property="og:locale" content="en_IE" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="hero hero-sub" id="top">
      <HeroTop company={company} contact={contact} linkHome />
      <div class="intro">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li aria-current="page">{servicePage.homeLinkText}</li>
          </ol>
        </nav>
        <h1>{servicePage.heading}</h1>
        <p>{servicePage.lede}</p>
      </div>
    </header>

    <main id="main">
      <section class="full-block bg-light page-section" aria-labelledby="overview-h">
        <div class="page-inner">
          <h2 id="overview-h">{servicePage.introHeading}</h2>
          {servicePage.intro.map((paragraph) => <p>{paragraph}</p>)}
          <p><a class="text-link" href="#contact">Contact us for a quote.</a></p>
        </div>
      </section>

      <section class="full-block bg-bright page-section ev" aria-labelledby="list-h">
        <div class="page-inner">
          <h2 id="list-h">{servicePage.listHeading}</h2>
          <ul class="disc-list" data-testid="service-items">
            {servicePage.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </section>

      <section class="full-block bg-dark page-section" aria-labelledby="faq-h">
        <div class="page-inner">
          <h2 id="faq-h">{servicePage.faqHeading}</h2>
          <dl class="faq-list faq-list-on-grey" data-testid="service-faq">
            {servicePage.faq.map((entry) => (
              <div>
                <dt>{entry.question}</dt>
                <dd>{entry.answer}</dd>
              </div>
            ))}
          </dl>
          <p class="source-note">
            {servicePage.sourceNote}
            {servicePage.sourceUrl && (
              <> <a class="text-link" href={servicePage.sourceUrl} rel="noopener">Read the source</a>.</>
            )}
          </p>
        </div>
      </section>
    </main>

    <ContactFooter company={company} contact={contact} />
  </body>
</html>
