---
import "@fontsource/public-sans/400";
import "@fontsource/public-sans/600";
import "@fontsource/public-sans/700";
import "@fontsource/ibm-plex-mono/500";
import content from "../../content/home.json";
import PylonArt from "../components/PylonArt.astro";

const { company, about, services, installation, clients, staff, contact, domestic } = content;

const [featuredClient, ...otherClients] = clients.entries;

const splitProject = (project) => {
  const match = project.match(/^([0-9]{4}(?:\u2013[0-9]{4}|-[0-9]{4})?):\s*(.*)$/);
  if (match) {
    return { year: match[1], detail: match[2] };
  }
  return { year: null, detail: project };
};
const telHref = `tel:+353${contact.tel.replace(/\s/g, "").replace(/^0/, "")}`;
const mobileHref = `tel:+353${contact.mobile.replace(/\s/g, "").replace(/^0/, "")}`;

const sections = [
  { id: "about", index: "01", label: "About" },
  { id: "services", index: "02", label: "Services" },
  { id: "installation", index: "03", label: "Installation" },
  { id: "clients", index: "04", label: "Clients" },
  { id: "contact", index: "05", label: "Contact" },
];
---

<html lang="en-IE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{company.name} — Electrical Contractors, Dublin & Leinster</title>
    <meta
      name="description"
      content={`${company.name}: domestic, commercial and industrial electrical contracting and solar PV installation across Ireland. RECI registered.`}
    />
  </head>
  <body>
    <a class="skip-link" href="#about">Skip to content</a>

    <header class="site-header">
      <div class="shell header-row">
        <a class="brand" href="#top">{company.shortName} <span>Electrical</span></a>
        <nav aria-label="Sections">
          <ul class="nav-list">
            {sections.slice(0, 4).map((section) => (
              <li><a href={`#${section.id}`}>{section.label}</a></li>
            ))}
          </ul>
        </nav>
        <a class="btn header-phone" href={mobileHref}>{contact.mobile}</a>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="shell hero-inner">
          <div class="hero-art" aria-hidden="true"><PylonArt /></div>
          <p class="hero-reg" data-testid="registration-line">{company.registrationLine}</p>
          <h1>{company.name}</h1>
          <p class="lede">{company.tagline}</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#contact">Request a quote</a>
            <a class="btn btn-secondary" href="#services">See our services</a>
          </div>
        </div>
      </section>

      <section class="section" id="about" aria-labelledby="about-h">
        <div class="shell">
          <p class="eyebrow">01 — About</p>
          <h2 id="about-h">{about.heading}</h2>
          <div class="prose">
            {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            <p class="list-heading">{about.expertiseHeading}</p>
            <ul class="expertise-list">
              {about.expertise.map((item) => <li>{item}</li>)}
            </ul>
            {about.closingParagraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </section>

      <section class="section section-alt" id="services" aria-labelledby="services-h">
        <div class="shell">
          <p class="eyebrow">02 — Services</p>
          <h2 id="services-h">What we do</h2>
          <div class="card-grid">
            {services.map((service) => (
              <article class="card">
                <h3>{service.title}</h3>
                <p>{service.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>


      <section class="section" id="installation" aria-labelledby="installation-h">
        <div class="shell">
          <p class="eyebrow">03 — Installation</p>
          <h2 id="installation-h">{installation.heading}</h2>
          <div class="prose">
            <p>{installation.intro}</p>
          </div>
          <ul class="service-list" data-testid="installation-services">
            {installation.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </section>

      <section class="section section-alt" id="clients" aria-labelledby="clients-h">
        <div class="shell">
          <p class="eyebrow">04 — Clients</p>
          <h2 id="clients-h">{clients.heading}</h2>
          <div class="prose">
            <p>{clients.intro}</p>
          </div>
          <article class="featured-client">
            <div class="featured-head">
              <h3>{featuredClient.name}</h3>
              <p class="featured-meta">{featuredClient.projects.length} developments</p>
            </div>
            <ul class="project-grid">
              {featuredClient.projects.map((project) => {
                const { year, detail } = splitProject(project);
                return (
                  <li>
                    {year && <span class="project-year">{year}</span>}
                    <span>{detail}</span>
                  </li>
                );
              })}
            </ul>
          </article>
          <div class="client-row">
            {otherClients.map((client) => (
              <article class="client-card">
                <div class="client-card-head">
                  <h3>{client.name}</h3>
                  {client.tag && <span class="client-tag">{client.tag}</span>}
                </div>
                {client.projects.map((project) => <p>{project}</p>)}
              </article>
            ))}
          </div>
          <div class="domestic-block">
            <h3>{domestic.heading}</h3>
            <p class="domestic-intro">{domestic.intro}</p>
            <ul class="domestic-list">
              {domestic.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div class="prose quality-note">
            {staff.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </section>
    </main>

    <footer class="section contact" id="contact" aria-labelledby="contact-h">
      <div class="shell">
        <p class="eyebrow">05 — Contact</p>
        <h2 id="contact-h">{contact.heading}</h2>
        <div class="prose">
          <p>{contact.intro}</p>
        </div>
        <dl class="contact-grid">
          <div>
            <dt>Tel</dt>
            <dd><a href={telHref}>{contact.tel}</a></dd>
          </div>
          <div>
            <dt>Mobile</dt>
            <dd><a href={mobileHref}>{contact.mobile}</a></dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
          </div>
          <div>
            <dt>LinkedIn</dt>
            <dd><a href={contact.linkedin} rel="noopener">Barry Smith</a></dd>
          </div>
        </dl>
        <p class="footer-reg">{company.name} · {company.registrationLine}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    --white: #ffffff;
    --tint: #f0f3f6;
    --line: #e3e8ec;
    --ink: #1a1d21;
    --muted: #556070;
    --accent: #0f6ea3;
    --accent-dark: #0c5a86;
    --body: "Public Sans", system-ui, sans-serif;
    --mono: "IBM Plex Mono", monospace;
    --shell: 64rem;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 4.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    margin: 0;
    font-family: var(--body);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--ink);
    background: var(--white);
  }

  .shell {
    max-width: var(--shell);
    margin: 0 auto;
    padding-inline: clamp(1.25rem, 5vw, 2.5rem);
  }

  .skip-link {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--ink);
    color: var(--white);
    padding: 0.6rem 1rem;
    z-index: 20;
  }

  .skip-link:focus {
    left: 0;
  }

  /* ---------- header ---------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .header-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 3.75rem;
  }

  .brand {
    font-weight: 700;
    text-decoration: none;
    color: var(--ink);
    white-space: nowrap;
  }

  .brand span {
    color: var(--accent);
  }

  .nav-list {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0 auto;
    padding: 0;
  }

  .nav-list a {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
  }

  .nav-list a:hover {
    color: var(--accent);
  }

  .header-phone {
    margin-left: auto;
    border: 1px solid var(--line);
    color: var(--ink);
    font-weight: 600;
    white-space: nowrap;
  }

  .header-phone:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (max-width: 48rem) {
    .nav-list {
      display: none;
    }
  }

  /* ---------- hero ---------- */
  .hero {
    position: relative;
    padding-block: clamp(4rem, 14vh, 8rem);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
  }

  .hero-art {
    position: absolute;
    right: -6rem;
    top: 50%;
    transform: translateY(-50%);
    width: clamp(22rem, 38vw, 30rem);
    color: #dfe6ea;
    pointer-events: none;
    user-select: none;
  }

  .hero-art :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero .hero-reg,
  .hero h1,
  .hero .lede,
  .hero .hero-actions {
    position: relative;
  }

  @media (max-width: 56rem) {
    .hero-art {
      display: none;
    }
  }

  .hero-reg {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.25rem;
  }

  .hero h1 {
    font-size: clamp(2.1rem, 6vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.08;
    margin: 0 0 1.25rem;
    max-width: 22ch;
  }

  .lede {
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    color: var(--muted);
    max-width: 36rem;
    margin: 0 0 2.25rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn {
    display: inline-block;
    padding: 0.7rem 1.35rem;
    border-radius: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  .btn-primary {
    background: var(--accent);
    color: var(--white);
  }

  .btn-primary:hover {
    background: var(--accent-dark);
  }

  .btn-secondary {
    border: 1px solid var(--line);
    color: var(--ink);
  }

  .btn-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ---------- sections ---------- */
  .section {
    padding-block: clamp(3.5rem, 10vh, 6rem);
  }

  .section-alt {
    background: var(--tint);
    border-block: 1px solid var(--line);
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.75rem;
  }

  .section h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.15;
    margin: 0 0 1.25rem;
  }

  .prose {
    max-width: 42rem;
  }

  .prose p {
    margin: 0 0 1rem;
    color: var(--muted);
  }

  .prose p:last-child {
    margin-bottom: 0;
  }

  .list-heading {
    font-weight: 600;
    color: var(--ink);
  }

  .expertise-list {
    margin: 0 0 1.25rem;
    padding: 0 0 0 1.2rem;
    color: var(--muted);
  }

  .expertise-list li {
    margin-bottom: 0.35rem;
  }

  /* ---------- services cards ---------- */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    padding: 1.75rem;
  }

  .card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0 0 0.6rem;
  }

  .card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
  }

  /* ---------- installation list ---------- */
  .service-list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0.6rem 2rem;
    max-width: 52rem;
  }

  .service-list li {
    padding: 0.55rem 0 0.55rem 1.4rem;
    position: relative;
    border-bottom: 1px solid var(--line);
    font-size: 0.98rem;
  }

  .service-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.05rem;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
  }

  /* ---------- clients ---------- */
  .featured-client {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    padding: 1.75rem;
    margin-top: 2rem;
  }

  .featured-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .featured-client h3,
  .client-card h3,
  .domestic-block h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
  }

  .featured-meta {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
    margin: 0;
  }

  .project-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 0.4rem 2rem;
  }

  .project-grid li {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.92rem;
    color: var(--muted);
  }

  .project-year {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--accent);
    white-space: nowrap;
  }

  .client-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .client-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    padding: 1.25rem 1.5rem;
  }

  .client-card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .client-tag {
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    background: #e7f1f8;
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    white-space: nowrap;
  }

  .client-card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .domestic-block {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    padding: 1.25rem 1.5rem;
    margin-top: 1rem;
  }

  .domestic-intro {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0.4rem 0 0.75rem;
  }

  .domestic-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .domestic-list li {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    font-size: 0.9rem;
  }

  .quality-note {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  /* ---------- contact ---------- */
  .contact {
    background: var(--ink);
    color: var(--white);
    border-top: 1px solid var(--ink);
  }

  .contact .eyebrow {
    color: #7fb8dc;
  }

  .contact .prose p {
    color: #b6bec7;
  }

  .contact-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin: 2rem 0 2.5rem;
  }

  .contact-grid dt {
    font-family: var(--mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #8d97a1;
    margin-bottom: 0.25rem;
  }

  .contact-grid dd {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .contact-grid a {
    color: var(--white);
    text-decoration: none;
    border-bottom: 1px solid #7fb8dc;
  }

  .contact-grid a:hover {
    color: #7fb8dc;
  }

  .contact a:focus-visible {
    outline-color: #7fb8dc;
  }

  .footer-reg {
    font-size: 0.85rem;
    color: #8d97a1;
    margin: 0;
  }

  a:focus-visible,
  .btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>
