---
import "../styles/site.css";
import content from "../../content/home.json";
import HeroTop from "../components/HeroTop.astro";
import ContactFooter from "../components/ContactFooter.astro";
import { toTelHref } from "../lib/phone.js";

const { company, about, services, installation, ev, evPage, clients, staff, contact, domestic } = content;

const [featuredClient, ...otherClients] = clients.entries;

const splitProject = (project) => {
  const match = project.match(/^([0-9]{4}(?:\u2013[0-9]{4}|-[0-9]{4})?):\s*(.*)$/);
  if (match) {
    return { year: match[1], detail: match[2] };
  }
  return { year: null, detail: project };
};
const telHref = contact.tel ? toTelHref(contact.tel) : null;
const mobileHref = toTelHref(contact.mobile);
const clientLogos = { "Space Storage": { src: "/img/spacestorage_logo.gif", alt: "Space Self Storage" } };
---

<html lang="en-IE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/fraulein.woff" as="font" type="font/woff" crossorigin />
    <link rel="canonical" href="https://barrysmithelectrical.ie/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://barrysmithelectrical.ie/" />
    <meta property="og:title" content="Barry Smith Electrical | Electricians Dublin & Leinster" />
    <meta property="og:description" content="RECI registered electrical contractors in Dublin and Leinster. Domestic, commercial and industrial work, solar PV and EV charger installation." />
    <meta property="og:image" content="https://barrysmithelectrical.ie/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Barry Smith Electrical Contractors Ltd — domestic, commercial, solar PV and EV chargers, Dublin and Leinster" />
    <meta property="og:locale" content="en_IE" />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Electrician",
        name: company.name,
        url: "https://barrysmithelectrical.ie/",
        telephone: [mobileHref, telHref].filter(Boolean).map((href) => href.replace("tel:", "")),
        email: contact.email,
        areaServed: [
          { "@type": "AdministrativeArea", name: "Dublin" },
          { "@type": "AdministrativeArea", name: "Leinster" },
          { "@type": "Country", name: "Ireland" },
        ],
        address: {
          "@type": "PostalAddress",
          addressRegion: "Leinster",
          addressCountry: "IE",
        },
        sameAs: [contact.linkedin],
        knowsAbout: [
          "Domestic electrical installation",
          "Commercial and industrial electrical services",
          "Solar PV installation",
          "Fire alarm systems",
          "EV charger installation",
        ],
        memberOf: {
          "@type": "Organization",
          name: "Register of Electrical Contractors of Ireland (RECI)",
        },
      })}
    />
    <title>Barry Smith Electrical | Electricians Dublin & Leinster</title>
    <meta name="description" content="RECI registered electrical contractors in Dublin and Leinster. Domestic, commercial and industrial work, solar PV and EV charger installation." />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="hero" id="top">
      <HeroTop company={company} contact={contact} />
      <div class="intro">
        <h1>{company.name}</h1>
        <p>{company.tagline}</p>
        <p class="intro-reg" data-testid="registration-line">{company.registrationLine}</p>
      </div>
    </header>

    <main id="main">
      <section class="split" aria-label="Services">
        {services.map((service, index) => (
          <article class={index === 0 ? "split-block bg-bright" : "split-block bg-dark"}>
            <h2>{service.title}</h2>
            <p>{service.body}</p>
          </article>
        ))}
      </section>

      <section class="full-block bg-light" id="about" aria-labelledby="about-h">
        <div class="flag">
          <div class="flag-body">
            <h2 id="about-h">{about.heading}</h2>
            {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            <p class="list-heading">{about.expertiseHeading}</p>
            <ul class="disc-list">
              {about.expertise.map((item) => <li>{item}</li>)}
            </ul>
            {about.closingParagraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <div class="flag-img flag-img-r">
            <img src="/img/solar-panel.jpg" alt="" width="500" height="446" loading="lazy" />
          </div>
        </div>
      </section>

      <section class="full-block bg-dark" id="installation" aria-labelledby="installation-h">
        <div class="flag">
          <div class="flag-img flag-img-l">
            <img src="/img/blueprint.jpg" alt="" width="822" height="626" loading="lazy" />
          </div>
          <div class="flag-body">
            <h2 id="installation-h">{installation.heading}</h2>
            <p>{installation.intro}</p>
            <ul class="two-col-list" data-testid="installation-services">
              {installation.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section class="full-block bg-bright ev" id="ev-chargers" aria-labelledby="ev-h">
        <div class="ev-inner">
          <h2 id="ev-h">{ev.heading}</h2>
          <p>{ev.intro}</p>
          <div class="ev-columns">
            <div>
              <h3>{ev.grantHeading}</h3>
              <p>{ev.grantBody}</p>
              <p><a class="ev-link" href={ev.grantUrl} rel="noopener">{ev.grantLinkText}</a></p>
            </div>
            <div>
              <h3>{ev.includedHeading}</h3>
              <ul class="disc-list" data-testid="ev-included">
                {ev.included.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
          <p class="ev-cta"><a href="/ev-charger-installation/">{evPage.homeLinkText}</a></p>
          <p class="ev-cta"><a href="#contact">{ev.cta}</a></p>
        </div>
      </section>

      <section class="full-block bg-light clients" id="clients" aria-labelledby="clients-h">
        <h2 id="clients-h">{clients.heading}</h2>
        <p class="clients-intro">{clients.intro}</p>

        <article class="featured-client">
          <h3>{featuredClient.name}</h3>
          <ul class="project-list">
            {featuredClient.projects.map((project) => {
              const { year, detail } = splitProject(project);
              return (
                <li>
                  {year && <span class="project-year">{year}</span>}
                  <span>{detail}</span>
                </li>
              );
            })}
          </ul>
        </article>

        <div class="client-row">
          {otherClients.map((client) => (
            <article class="client-card">
              {clientLogos[client.name] ? (
                <h3><img src={clientLogos[client.name].src} alt={clientLogos[client.name].alt} width="266" height="72" loading="lazy" /></h3>
              ) : (
                <h3>{client.name}</h3>
              )}
              {client.projects.map((project) => <p>{project}</p>)}
            </article>
          ))}
        </div>

        <div class="domestic-block">
          <h3>{domestic.heading}</h3>
          <p>{domestic.intro}</p>
          <ul class="disc-list">
            {domestic.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <blockquote class="quality-note">
          {staff.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </blockquote>
      </section>
    </main>

    <ContactFooter company={company} contact={contact} />
  </body>
</html>
