---
import content from "../../content/home.json";

const { company, about, services, installation, ev, clients, staff, contact, domestic } = content;

const [featuredClient, ...otherClients] = clients.entries;

const splitProject = (project) => {
  const match = project.match(/^([0-9]{4}(?:\u2013[0-9]{4}|-[0-9]{4})?):\s*(.*)$/);
  if (match) {
    return { year: match[1], detail: match[2] };
  }
  return { year: null, detail: project };
};
const toTelHref = (number) => `tel:+353${number.replace(/\s/g, "").replace(/^0/, "")}`;
const telHref = contact.tel ? toTelHref(contact.tel) : null;
const mobileHref = toTelHref(contact.mobile);
const clientLogos = { "Space Storage": { src: "/img/spacestorage_logo.gif", alt: "Space Self Storage" } };
---

<html lang="en-IE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/fraulein.woff" as="font" type="font/woff" crossorigin />
    <link rel="canonical" href="https://barrysmithelectrical.ie/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://barrysmithelectrical.ie/" />
    <meta property="og:title" content="Barry Smith Electrical | Electricians Dublin & Leinster" />
    <meta property="og:description" content="RECI registered electrical contractors in Dublin and Leinster. Domestic, commercial and industrial work, solar PV and EV charger installation." />
    <meta property="og:image" content="https://barrysmithelectrical.ie/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Barry Smith Electrical Contractors Ltd — domestic, commercial, solar PV and EV chargers, Dublin and Leinster" />
    <meta property="og:locale" content="en_IE" />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Electrician",
        name: company.name,
        url: "https://barrysmithelectrical.ie/",
        telephone: [mobileHref, telHref].filter(Boolean).map((href) => href.replace("tel:", "")),
        email: contact.email,
        areaServed: [
          { "@type": "AdministrativeArea", name: "Dublin" },
          { "@type": "AdministrativeArea", name: "Leinster" },
          { "@type": "Country", name: "Ireland" },
        ],
        address: {
          "@type": "PostalAddress",
          addressRegion: "Leinster",
          addressCountry: "IE",
        },
        sameAs: [contact.linkedin],
        knowsAbout: [
          "Domestic electrical installation",
          "Commercial and industrial electrical services",
          "Solar PV installation",
          "Fire alarm systems",
          "EV charger installation",
        ],
        memberOf: {
          "@type": "Organization",
          name: "Register of Electrical Contractors of Ireland (RECI)",
        },
      })}
    />
    <title>Barry Smith Electrical | Electricians Dublin & Leinster</title>
    <meta name="description" content="RECI registered electrical contractors in Dublin and Leinster. Domestic, commercial and industrial work, solar PV and EV charger installation." />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="hero" id="top">
      <div class="hero-top">
        <p class="logo">{company.shortName} <span>{company.descriptor} Ltd</span></p>
        <p class="hero-phone">Call <a href={mobileHref}>{contact.mobile}</a></p>
      </div>
      <div class="intro">
        <h1>{company.name}</h1>
        <p>{company.tagline}</p>
        <p class="intro-reg" data-testid="registration-line">{company.registrationLine}</p>
      </div>
    </header>

    <main id="main">
      <section class="split" aria-label="Services">
        {services.map((service, index) => (
          <article class={index === 0 ? "split-block bg-bright" : "split-block bg-dark"}>
            <h2>{service.title}</h2>
            <p>{service.body}</p>
          </article>
        ))}
      </section>

      <section class="full-block bg-light" id="about" aria-labelledby="about-h">
        <div class="flag">
          <div class="flag-body">
            <h2 id="about-h">{about.heading}</h2>
            {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            <p class="list-heading">{about.expertiseHeading}</p>
            <ul class="disc-list">
              {about.expertise.map((item) => <li>{item}</li>)}
            </ul>
            {about.closingParagraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <div class="flag-img flag-img-r">
            <img src="/img/solar-panel.jpg" alt="" width="500" height="446" loading="lazy" />
          </div>
        </div>
      </section>

      <section class="full-block bg-dark" id="installation" aria-labelledby="installation-h">
        <div class="flag">
          <div class="flag-img flag-img-l">
            <img src="/img/blueprint.jpg" alt="" width="822" height="626" loading="lazy" />
          </div>
          <div class="flag-body">
            <h2 id="installation-h">{installation.heading}</h2>
            <p>{installation.intro}</p>
            <ul class="two-col-list" data-testid="installation-services">
              {installation.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section class="full-block bg-bright ev" id="ev-chargers" aria-labelledby="ev-h">
        <div class="ev-inner">
          <h2 id="ev-h">{ev.heading}</h2>
          <p>{ev.intro}</p>
          <div class="ev-columns">
            <div>
              <h3>{ev.grantHeading}</h3>
              <p>{ev.grantBody}</p>
              <p><a class="ev-link" href={ev.grantUrl} rel="noopener">{ev.grantLinkText}</a></p>
            </div>
            <div>
              <h3>{ev.includedHeading}</h3>
              <ul class="disc-list" data-testid="ev-included">
                {ev.included.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
          <p class="ev-cta"><a href="#contact">{ev.cta}</a></p>
        </div>
      </section>

      <section class="full-block bg-light clients" id="clients" aria-labelledby="clients-h">
        <h2 id="clients-h">{clients.heading}</h2>
        <p class="clients-intro">{clients.intro}</p>

        <article class="featured-client">
          <h3>{featuredClient.name}</h3>
          <ul class="project-list">
            {featuredClient.projects.map((project) => {
              const { year, detail } = splitProject(project);
              return (
                <li>
                  {year && <span class="project-year">{year}</span>}
                  <span>{detail}</span>
                </li>
              );
            })}
          </ul>
        </article>

        <div class="client-row">
          {otherClients.map((client) => (
            <article class="client-card">
              {clientLogos[client.name] ? (
                <h3><img src={clientLogos[client.name].src} alt={clientLogos[client.name].alt} width="266" height="72" loading="lazy" /></h3>
              ) : (
                <h3>{client.name}</h3>
              )}
              {client.projects.map((project) => <p>{project}</p>)}
            </article>
          ))}
        </div>

        <div class="domestic-block">
          <h3>{domestic.heading}</h3>
          <p>{domestic.intro}</p>
          <ul class="disc-list">
            {domestic.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <blockquote class="quality-note">
          {staff.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </blockquote>
      </section>
    </main>

    <footer class="contact bg-bright" id="contact" aria-labelledby="contact-h">
      <div class="contact-body">
        <h2 id="contact-h">{contact.heading}</h2>
        <p>{contact.intro}</p>
        <ul class="contact-list">
          {telHref && <li><span>Tel:</span><a href={telHref}>{contact.tel}</a></li>}
          <li><span>Mobile:</span><a href={mobileHref}>{contact.mobile}</a></li>
          <li><span>Email:</span><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          <li><span>LinkedIn:</span><a href={contact.linkedin} rel="noopener">Barry Smith</a></li>
        </ul>
        <div class="badges">
          <img src="/img/reci.png" alt="RECI registered electrical contractor" width="106" height="63" />
          <img src="/img/safe_elec.jpg" alt="Safe Electric registered electrical contractor, fully insured and C2 registered" width="158" height="82" />
        </div>
        <p class="footer-reg">{company.name} · {company.registrationLine}</p>
      </div>
      <div class="contact-art">
        <img src="/img/tower.png" alt="" width="318" height="470" />
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Fraulein";
    src: url("/fonts/fraulein.woff") format("woff");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
</style>

<style>
  /* Original 2015 palette. Blue darkened from #138acb to #0f7bb6 so white text passes WCAG AA (4.6:1). */
  :root {
    --blue: #0f7bb6;
    --grey: #b9b9ba;
    --white: #ffffff;
    --page: #eeeeee;
    --ink: #111111;
    --body: "HelveticaNeue-Light", "Helvetica Neue Light", "Helvetica Neue", Helvetica, Arial, sans-serif;
    --logo: "Fraulein", Georgia, serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    max-width: 1600px;
    margin: 0 auto;
    font-family: var(--body);
    font-weight: 300;
    font-size: clamp(1.05rem, 1.4vw, 1.375rem);
    line-height: 1.8;
    color: var(--ink);
    background: var(--page);
  }

  h1,
  h2,
  h3 {
    font-weight: 300;
    line-height: 1.15;
    margin: 0 0 1.5rem;
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3.125rem);
  }

  h3 {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
  }

  p {
    margin: 0 0 1.5rem;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  a {
    color: inherit;
  }

  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .skip-link {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--ink);
    color: var(--white);
    padding: 0.6rem 1rem;
    z-index: 20;
  }

  .skip-link:focus {
    left: 0;
  }

  .bg-bright {
    background: var(--blue);
    color: var(--white);
  }

  .bg-dark {
    background: var(--grey);
    color: var(--ink);
  }

  .bg-light {
    background: var(--white);
    color: var(--ink);
  }

  /* ---------- hero ---------- */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 650px;
    color: var(--white);
    background:
      linear-gradient(90deg, rgba(20, 18, 15, 0.75) 0%, rgba(20, 18, 15, 0.35) 55%, rgba(20, 18, 15, 0) 75%),
      url("/img/hero-bulb.jpg") center top / cover no-repeat #2a2622;
  }

  .hero-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding: 20px 40px;
  }

  /* Original sizing: 120px logo on a 40px line, 48.5px descriptor on the same 40px line. */
  .logo {
    font-family: var(--logo);
    font-size: clamp(3rem, 17vw, 7.5rem);
    line-height: 0.34em;
    white-space: nowrap;
    margin: 0;
    padding-top: 0.17em;
  }

  .logo span {
    display: block;
    font-size: 0.404em;
    line-height: 0.83em;
  }

  .hero-phone {
    font-size: clamp(1.25rem, 2.2vw, 1.875rem);
    margin: 0;
    line-height: 58px;
  }

  .hero-phone a {
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.6);
  }

  .intro {
    padding: 40px;
    width: 65%;
    max-width: 36rem;
  }

  .intro h1 {
    font-size: clamp(1.6rem, 2.6vw, 2rem);
    margin-bottom: 0.75rem;
  }

  .intro p {
    max-width: 1200px;
    margin-bottom: 0.75rem;
  }

  .intro-reg {
    font-size: 0.85em;
    opacity: 0.9;
  }

  @media (max-width: 58.75em) {
    .hero {
      min-height: 0;
      background-position: center, 30% top;
      text-align: center;
    }

    .hero-top {
      flex-direction: column;
      align-items: center;
      padding: 20px 24px;
    }

    .intro {
      width: 100%;
      max-width: none;
      padding: 120px 24px 32px;
    }
  }

  /* ---------- services split ---------- */
  .split {
    display: flex;
    flex-wrap: wrap;
  }

  .split-block {
    flex: 1 1 50%;
    min-height: 450px;
    padding: 120px 40px;
  }

  .split-block p {
    margin: 0;
  }

  @media (max-width: 58.75em) {
    .split-block {
      flex-basis: 100%;
      min-height: 0;
      padding: 56px 24px;
      text-align: center;
    }
  }

  /* ---------- flag sections (text + angled image) ---------- */
  .full-block {
    padding: 60px 40px;
  }

  .flag {
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .flag-body {
    flex: 1 1 auto;
    padding: 0 40px;
  }

  .flag-body p {
    max-width: 700px;
  }

  .flag-img {
    position: relative;
    flex: 0 0 auto;
    width: min(500px, 40%);
    overflow: hidden;
  }

  .flag-img img {
    display: block;
    width: 100%;
  }

  .flag-img::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 100px;
  }

  .flag-img-r::after {
    left: 0;
    background: var(--white);
    clip-path: polygon(0 0, 100% 100%, 0 100%);
  }

  .flag-img-l::after {
    right: 0;
    background: var(--grey);
    clip-path: polygon(100% 0, 100% 100%, 0 100%);
  }

  @media (max-width: 58.75em) {
    .full-block {
      padding: 0 0 24px;
    }

    .flag {
      flex-direction: column;
      gap: 0;
    }

    .flag-img {
      width: 100%;
      order: -1;
    }

    .flag-img::after {
      display: none;
    }

    .flag-body {
      padding: 36px 24px 12px;
    }

    .flag-body p {
      max-width: 100%;
    }
  }

  .list-heading {
    margin-bottom: 0.5rem;
  }

  .disc-list,
  .two-col-list {
    list-style: disc outside;
    margin: 0 0 1.5rem;
    padding: 0 0 0 1.25em;
  }

  .two-col-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
    column-gap: 1.5rem;
    font-size: 0.92em;
  }

  /* ---------- EV chargers ---------- */
  .ev-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 40px;
  }

  .ev-inner > p {
    max-width: 800px;
  }

  .ev-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: 2rem 4rem;
    margin-top: 1rem;
  }

  .ev a {
    color: var(--white);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .ev-cta {
    margin: 1rem 0 0;
  }

  @media (max-width: 58.75em) {
    .ev {
      padding: 0;
    }

    .ev-inner {
      padding: 48px 24px;
    }
  }

  /* ---------- clients ---------- */
  .clients {
    text-align: center;
  }

  .clients-intro {
    max-width: 700px;
    margin-inline: auto;
  }

  .featured-client,
  .client-row,
  .domestic-block,
  .quality-note {
    max-width: 1200px;
    margin-inline: auto;
  }

  .featured-client {
    border-top: 4px solid var(--blue);
    padding-top: 2rem;
    margin-top: 2rem;
  }

  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: 0 2rem;
    text-align: left;
  }

  .project-list li {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.5rem 0;
    border-bottom: 1px solid #d4d4d4;
    font-size: 0.9em;
  }

  .project-year {
    color: var(--blue);
    font-weight: 400;
    white-space: nowrap;
  }

  .client-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .client-card {
    background: var(--page);
    padding: 1.75rem 1.5rem;
  }

  .client-card h3 {
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .client-card p {
    margin: 0;
    font-size: 0.9em;
  }

  .domestic-block {
    margin-top: 3rem;
  }

  .domestic-block .disc-list {
    list-style-position: inside;
    padding-left: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 2rem;
  }

  .quality-note {
    margin-top: 3rem;
    margin-bottom: 0;
    padding: 2.5rem 0 0;
    border-top: 1px solid #d4d4d4;
    font-style: italic;
  }

  .quality-note p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 58.75em) {
    .clients {
      padding: 48px 24px;
    }
  }

  /* ---------- contact footer ---------- */
  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
  }

  .contact-body {
    flex: 1 1 50%;
    padding: 80px 80px 60px;
  }

  .contact-body > p {
    max-width: 700px;
  }

  .contact-list {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    font-size: clamp(1.15rem, 2vw, 1.875rem);
  }

  .contact-list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
  }

  .contact-list span {
    display: inline-block;
    min-width: 7.5rem;
  }

  .contact-list a {
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.6);
    overflow-wrap: anywhere;
  }

  .contact-list a:hover {
    border-bottom-color: var(--white);
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px;
    margin-bottom: 2rem;
  }

  .badges img {
    background: var(--white);
    padding: 6px;
  }

  .footer-reg {
    font-size: 0.8em;
    margin: 0;
  }

  .contact-art {
    flex: 1 1 50%;
    text-align: center;
  }

  .contact-art img {
    display: block;
    margin: 0 auto;
  }

  @media (max-width: 58.75em) {
    .contact {
      text-align: center;
    }

    .contact-body {
      flex-basis: 100%;
      padding: 48px 24px 24px;
    }

    .contact-list li {
      justify-content: center;
    }

    .contact-list span {
      min-width: 0;
    }

    .badges {
      justify-content: center;
    }

    .contact-art {
      flex-basis: 100%;
    }

    .contact-art img {
      width: 200px;
    }
  }
</style>
